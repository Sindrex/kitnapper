    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    TextType:
    - languageEnum: 0
      LanguageGenericType: I'm Richard, Regional Director of this office.
    - languageEnum: 1
      LanguageGenericType: 
    Duration: 10
  - NodeGuid: 3bc8a010-d4c5-4e58-8393-b0208119683e
    Position: {x: 498, y: 789}
    Character: {fileID: 0}
    PortraitPosition: 0
    Emotion: 
