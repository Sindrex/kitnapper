    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    TextType:
    - languageEnum: 0
      LanguageGenericType: Despite some, uh, minor local protests, we are on track
        to overtake the relevant competition in a matter of months.
    - languageEnum: 1
      LanguageGenericType: 
    Duration: 10
  - NodeGuid: 3bc8a010-d4c5-4e58-8393-b0208119683e
