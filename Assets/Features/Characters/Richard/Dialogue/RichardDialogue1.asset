    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    TextType:
    - languageEnum: 0
      LanguageGenericType: Oh, listen to me! You will have to excuse me Detective.
        When I start the corporate talk, it all comes spilling out of me.
    - languageEnum: 1
      LanguageGenericType: 
    Duration: 10
  - NodeGuid: c6ac20db-28c4-4c59-9208-956485c6039d
