    SecoundPortraitPosition: 0
    SecoundEmotion: 
    AudioClips:
    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    TextType:
    - languageEnum: 0
      LanguageGenericType: But the kicker is, it got stolen just the other day! And
        the only clue I found was some gray fur...
    - languageEnum: 1
      LanguageGenericType: 
    Duration: 10
  - NodeGuid: fe6767e8-424f-4f59-a34c-1426f30ad6ff
