    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    TextType:
    - languageEnum: 0
      LanguageGenericType: I'm Richard, Regional Director of CIT for this office.
    - languageEnum: 1
      LanguageGenericType: 
    Duration: 10
  - NodeGuid: c2734396-3245-4da4-a5c7-f6649dc8804f
