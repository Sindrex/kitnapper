    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    TextType:
    - languageEnum: 0
      LanguageGenericType: Heh, that's what I thought. Don't underestimate your elders
        sonny boy!
    - languageEnum: 1
      LanguageGenericType: 
