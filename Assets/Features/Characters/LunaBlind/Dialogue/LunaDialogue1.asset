    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    TextType:
    - languageEnum: 0
      LanguageGenericType: 'The Midnight Rose? Yes, I bought one just this week from
        sweet, sweet Poppy. It is the most beautiful flower darling. '
    - languageEnum: 1
      LanguageGenericType: 
    Duration: 10
  - NodeGuid: ae8a2701-2e80-4873-ba39-079ac4d8c439
