    SecoundCharacter: {fileID: 0}
    SecoundPortraitPosition: 0
    SecoundEmotion: 
    AudioClips:
    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    TextType:
    - languageEnum: 0
      LanguageGenericType: 'You know? Sometimes my disability makes it harder for
        me to connect with other people. '
    - languageEnum: 1
      LanguageGenericType: 
    Duration: 10
  - NodeGuid: f751c2b0-46cc-4a63-9344-a68b4e784977
    Position: {x: 1625, y: -14}
    Character: {fileID: 0}
    PortraitPosition: 0
