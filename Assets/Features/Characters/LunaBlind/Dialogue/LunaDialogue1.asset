    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    TextType:
    - languageEnum: 0
      LanguageGenericType: The colors are gone!? I did not know!
    - languageEnum: 1
      LanguageGenericType: 
    Duration: 10
  - NodeGuid: 25f936bd-798f-4c3d-9d5c-65cb7e771398
    Position: {x: 840, y: 812}
    Character: {fileID: 0}
    PortraitPosition: 0
    Emotion: 
