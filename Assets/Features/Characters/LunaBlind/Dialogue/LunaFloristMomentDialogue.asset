    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    TextType:
    - languageEnum: 0
      LanguageGenericType: 'Poppy: I guess you''re right...'
    - languageEnum: 1
      LanguageGenericType: 
    Duration: 10
  - NodeGuid: e15c0f1f-ca52-4565-b0fc-6e5fb21203b3
    Position: {x: 2970, y: 630}
