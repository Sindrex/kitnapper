    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    TextType:
    - languageEnum: 0
      LanguageGenericType: 'Luna: I know, darling. '
    - languageEnum: 1
      LanguageGenericType: 
    Duration: 10
  - NodeGuid: ae097847-51ff-45e6-a710-0a3d7f60c45d
    Position: {x: 2185, y: 630}
    Character: {fileID: 0}
    PortraitPosition: 0
    Emotion: 
    Event: 
    SecoundCharacter: {fileID: 0}
    SecoundPortraitPosition: 0
    SecoundEmotion: 
    AudioClips:
    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    TextType:
    - languageEnum: 0
      LanguageGenericType: But maybe while we wait for the Detective to bring their
        colors back, there's something to learn here.
    - languageEnum: 1
      LanguageGenericType: 
    Duration: 10
  - NodeGuid: a088c052-37ff-411f-b11e-018fc3168447
    Position: {x: 2446, y: 630}
    Character: {fileID: 0}
    PortraitPosition: 0
    Emotion: 
