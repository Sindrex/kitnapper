    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    TextType:
    - languageEnum: 0
      LanguageGenericType: 'Luna: Poppy, darling, listen...'
    - languageEnum: 1
      LanguageGenericType: 
    Duration: 10
  - NodeGuid: a3b31be8-cbc1-43d8-8adb-ee34b3096385
    Position: {x: 931, y: 630}
    Character: {fileID: 0}
    PortraitPosition: 0
    Emotion: 
    Event: 
    SecoundCharacter: {fileID: 0}
    SecoundPortraitPosition: 0
    SecoundEmotion: 
    AudioClips:
    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    TextType:
    - languageEnum: 0
      LanguageGenericType: It is the curves, the shapes, the texture and, god, the
        smell, darling! Flowers are amazing, with or without their colors!
    - languageEnum: 1
      LanguageGenericType: 
    Duration: 10
  - NodeGuid: 435226c3-b094-43ca-98e2-9e3be49be921
    Position: {x: 1184, y: 630}
    Character: {fileID: 0}
    PortraitPosition: 0
    Emotion: 
    Event: 
    SecoundCharacter: {fileID: 0}
    SecoundPortraitPosition: 0
    SecoundEmotion: 
    AudioClips:
    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    TextType:
    - languageEnum: 0
      LanguageGenericType: 'Poppy: I understand what you are saying. And I appreciate
        the sentiment Luna, I really do, but...'
    - languageEnum: 1
      LanguageGenericType: 
    Duration: 10
  - NodeGuid: 5a3d5602-0572-486d-a5a3-73a44e04e6f4
    Position: {x: 1444, y: 630}
    Character: {fileID: 0}
    PortraitPosition: 0
    Emotion: 
    Event: 
    SecoundCharacter: {fileID: 0}
    SecoundPortraitPosition: 0
    SecoundEmotion: 
    AudioClips:
    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    TextType:
    - languageEnum: 0
      LanguageGenericType: I just really loved their colors, you know?
    - languageEnum: 1
      LanguageGenericType: 
    Duration: 10
  - NodeGuid: 265bbd44-e859-4c2b-b39d-a30b925e6f57
    Position: {x: 1687, y: 630}
