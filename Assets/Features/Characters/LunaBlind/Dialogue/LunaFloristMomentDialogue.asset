    SecoundCharacter: {fileID: 0}
    SecoundPortraitPosition: 0
    SecoundEmotion: 
    AudioClips:
    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    TextType:
    - languageEnum: 0
      LanguageGenericType: To appreciate the whole flower, darling. And do not worry
        about your shop. I am sure it will be all right.
    - languageEnum: 1
      LanguageGenericType: 
    Duration: 10
  - NodeGuid: ed8e838d-b20d-4037-8bdd-9e72bfe20b2e
