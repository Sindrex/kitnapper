  - NodeGuid: cf257311-7fa9-4c48-a855-85cb9d555300
    Position: {x: 1143, y: 196}
    Character: {fileID: 0}
    PortraitPosition: 0
    Emotion: 
    Event: 
    SecoundCharacter: {fileID: 0}
    SecoundPortraitPosition: 0
    SecoundEmotion: 
    AudioClips:
    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    TextType:
    - languageEnum: 0
      LanguageGenericType: What have you got your paws on there?
    - languageEnum: 1
      LanguageGenericType: 
    Duration: 10
  - NodeGuid: 138b667b-51b1-4ff3-90d1-4a2a0205e3c3
    Position: {x: 1469, y: 196}
    Character: {fileID: 0}
    PortraitPosition: 0
    Emotion: 
    Event: 
    SecoundCharacter: {fileID: 0}
    SecoundPortraitPosition: 0
    SecoundEmotion: 
    AudioClips:
    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    TextType:
    - languageEnum: 0
      LanguageGenericType: A Midnight Butterfly! This rare species only drink nectar
        from the Midnight Rose, which only blooms during summer nights.
    - languageEnum: 1
      LanguageGenericType: 
    Duration: 10
  - NodeGuid: 693cdb95-ab3f-467c-925f-101923b65cad
    Position: {x: 2018, y: 196}
    Character: {fileID: 0}
    PortraitPosition: 0
    Emotion: 
    Event: 
    SecoundCharacter: {fileID: 0}
    SecoundPortraitPosition: 0
    SecoundEmotion: 
    AudioClips:
    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    TextType:
    - languageEnum: 0
      LanguageGenericType: I swear I put the records somewhere around here...
    - languageEnum: 1
      LanguageGenericType: 
    Duration: 10
  - NodeGuid: 1a0f9043-9955-4957-9e53-0fa16f11de69
    Position: {x: 2259, y: 196}
    Character: {fileID: 0}
    PortraitPosition: 0
    Emotion: 
    Event: TownHallMayorInitialDialogueEvent
    SecoundCharacter: {fileID: 0}
    SecoundPortraitPosition: 0
    SecoundEmotion: 
    AudioClips:
    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    TextType:
    - languageEnum: 0
      LanguageGenericType: 'Ah, yes! Here it is. Recently, Luna and Richard both
        bought one of these flowers. '
    - languageEnum: 1
      LanguageGenericType: 
    Duration: 10
  - NodeGuid: cdc1b14a-235e-4338-b578-91110baad130
    Position: {x: 1782, y: 196}
    Character: {fileID: 0}
    PortraitPosition: 0
    Emotion: 
    Event: 
    SecoundCharacter: {fileID: 0}
    SecoundPortraitPosition: 0
    SecoundEmotion: 
    AudioClips:
    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    TextType:
    - languageEnum: 0
      LanguageGenericType: I sell Midnight Roses here in my shop. I can find out
        whom I have sold it to recently, just give me a moment...
    - languageEnum: 1
      LanguageGenericType: 
    Duration: 10
  - NodeGuid: 49ae51f3-417b-497e-aa96-38a1ec91b121
    Position: {x: 1043, y: -121}
    Character: {fileID: 0}
    PortraitPosition: 0
    Emotion: 
    Event: 
    SecoundCharacter: {fileID: 0}
    SecoundPortraitPosition: 0
    SecoundEmotion: 
    AudioClips:
    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    TextType:
    - languageEnum: 0
      LanguageGenericType: I am worried I will not be able to sell my beautiful flowers.
    - languageEnum: 1
      LanguageGenericType: 
    Duration: 10
  - NodeGuid: 57d79352-3fe4-4018-a7f7-33da7eb00fd0
    Position: {x: 2512, y: 196}
    Character: {fileID: 0}
    PortraitPosition: 0
    Emotion: 
    Event: FloristInitialDialogueEvent
    SecoundCharacter: {fileID: 0}
    SecoundPortraitPosition: 0
    SecoundEmotion: 
    AudioClips:
    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    TextType:
    - languageEnum: 0
      LanguageGenericType: Luna is often seen over at the Cattelatte, right? Richard,
        on the other paw, is no doubt at the office still.
    - languageEnum: 1
      LanguageGenericType: 
    Duration: 10
  - NodeGuid: b39268b8-e9f0-4e82-9d56-ea60fc2daaeb
    Position: {x: 900, y: 799}
    Character: {fileID: 0}
    PortraitPosition: 0
    Emotion: 
    Event: 
    SecoundCharacter: {fileID: 0}
    SecoundPortraitPosition: 0
    SecoundEmotion: 
    AudioClips:
    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    TextType:
    - languageEnum: 0
      LanguageGenericType: Findus' Ball Toy? I've seen him play with that! He's always
        carrying it around when running errands!
    - languageEnum: 1
      LanguageGenericType: 
    Duration: 10
  - NodeGuid: 56266d62-c1e6-416b-8d8b-6574ecc3385c
    Position: {x: 900, y: 453}
    Character: {fileID: 0}
    PortraitPosition: 0
    Emotion: 
    Event: 
    SecoundCharacter: {fileID: 0}
    SecoundPortraitPosition: 0
    SecoundEmotion: 
    AudioClips:
    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    TextType:
    - languageEnum: 0
      LanguageGenericType: Last night I was out cold after rearranging the plants
        in the store, for the third time this week!
    - languageEnum: 1
      LanguageGenericType: 
    Duration: 10
  - NodeGuid: 09002230-bfd2-434d-b4b4-e66de7695229
    Position: {x: 138, y: -168}
    Character: {fileID: 0}
    PortraitPosition: 0
    Emotion: 
    Event: 
    SecoundCharacter: {fileID: 0}
    SecoundPortraitPosition: 0
    SecoundEmotion: 
    AudioClips:
    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    TextType:
    - languageEnum: 0
      LanguageGenericType: 'Poppy: Good prank you pulled on us Detective! I will
        be savouring this colorless moment while it lasts!'
    - languageEnum: 1
      LanguageGenericType: 
    Duration: 10
  - NodeGuid: f9369be4-9522-4660-9151-707050186286
