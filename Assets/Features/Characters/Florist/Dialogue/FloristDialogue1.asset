    - languageEnum: 0
      LanguageGenericType: {fileID: 0}
    - languageEnum: 1
      LanguageGenericType: {fileID: 0}
    TextType:
    - languageEnum: 0
      LanguageGenericType: As I said, it is a Midnight Butterfly. They only drink
        nectar from the Midnight Rose.
    - languageEnum: 1
      LanguageGenericType: 
    Duration: 10
  - NodeGuid: 5d8a4a39-d157-4dbf-8673-b0a34fa6ac7c
